nsplash.com%2Fphoto-1563805042-7684c019e1cb%3Fw%3D1200%26q%3D75%26auto%3Dformat%26fit%3Dcrop&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1563805042-7684c019e1cb%3Fw%3D1200%26q%3D75%26auto%3Dformat%26fit%3Dcrop&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1563805042-7684c019e1cb%3Fw%3D1200%26q%3D75%26auto%3Dformat%26fit%3Dcrop&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1563805042-7684c019e1cb%3Fw%3D1200%26q%3D75%26auto%3Dformat%26fit%3Dcrop&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1563805042-7684c019e1cb%3Fw%3D1200%26q%3D75%26auto%3Dformat%26fit%3Dcrop&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1563805042-7684c019e1cb%3Fw%3D1200%26q%3D75%26auto%3Dformat%26fit%3Dcrop&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=https%3A%2F%2Fimages.unsplash.com%2Fphoto-1563805042-7684c019e1cb%3Fw%3D1200%26q%3D75%26auto%3Dformat%26fit%3Dcrop&amp;w=3840&amp;q=75\"/><div class=\"absolute inset-0 bg-gradient-to-r from-[#2D1F14] via-[#2D1F14]/80 to-transparent\"></div></div><div class=\"relative max-w-6xl mx-auto px-4 py-20 md:py-28 lg:py-32\"><div class=\"max-w-2xl\"><span class=\"section-label text-[#C67B3A]\" style=\"opacity:0;transform:translateY(10px)\">Helados artesanales para tu negocio</span><h1 class=\"mt-6 font-display text-4xl md:text-5xl lg:text-6xl leading-[1.1] text-[#F5EFE0]\" style=\"opacity:0;transform:translateY(20px)\">Helados artesanales para cafeterías y hoteles.</h1><p class=\"mt-6 text-lg leading-8 text-[#F5EFE0]/70 max-w-lg\" style=\"opacity:0;transform:translateY(20px)\">Sabor artesanal para tu negocio. Sostenible, elevado y texturizado.</p><div class=\"mt-8 flex flex-col sm:flex-row gap-4\" style=\"opacity:0;transform:translateY(20px)\"><a href=\"#contacto\" class=\"btn-primary\">Ver catálogo<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" fill=\"currentColor\" viewBox=\"0 0 256 256\"><path d=\"M224.49,136.49l-72,72a12,12,0,0,1-17-17L187,140H40a12,12,0,0,1,0-24H187L135.51,64.48a12,12,0,0,1,17-17l72,72A12,12,0,0,1,224.49,136.49Z\"></path></svg></a><a href=\"https://wa.me/1234567890\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"btn-outline border-[#F5EFE0]/30 text-[#F5EFE0] hover:bg-[#F5EFE0] hover:text-[#2D1F14]\">Solicitar asesoría<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" fill=\"currentColor\" viewBox=\"0 0 256 256\"><path d=\"M152.58,145.23l23,11.48A24,24,0,0,1,152,176a72.08,72.08,0,0,1-72-72A24,24,0,0,1,99.29,80.46l11.48,23L101,118a8,8,0,0,0-.73,7.51,56.47,56.47,0,0,0,30.15,30.15A8,8,0,0,0,138,155ZM232,128A104,104,0,0,1,79.12,219.82L45.07,231.17a16,16,0,0,1-20.24-20.24l11.35-34.05A104,104,0,1,1,232,128Zm-40,24a8,8,0,0,0-4.42-7.16l-32-16a8,8,0,0,0-8,.5l-14.69,9.8a40.55,40.55,0,0,1-16-16l9.8-14.69a8,8,0,0,0,.5-8l-16-32A8,8,0,0,0,104,64a40,40,0,0,0-40,40,88.1,88.1,0,0,0,88,88A40,40,0,0,0,192,152Z\"></path></svg></a></div></div></div></section><section id=\"quienes-somos\" class=\"px-4 py-20 md:py-24 bg-[#F5EFE0]\"><div class=\"max-w-6xl mx-auto\"><div class=\"grid lg:grid-cols-2 gap-12 lg:gap-16 items-center\"><div style=\"opacity:0;transform:translateY(20px)\"><span class=\"section-label\">Quiénes somos</span><h2 class=\"mt-4 font-display text-3xl md:text-4xl leading-tight text-[#2D1F14]\">Sabor artesanal para tu negocio.</h2><p class=\"mt-5 text-base leading-7 text-[#2D1F14]/70\">Kayen es una heladería artesanal B2B que combina tradición y elegancia, creando productos para la hospitalidad más exigente. Nos especializamos en elaborar helados premium para cafeterías, hoteles, restaurantes y negocios que buscan diferenciarse con un producto de calidad superior.</p><p class=\"mt-4 text-base leading-7 text-[#2D1F14]/70\">Nuestra misión es simple: llevar el auténtico sabor artesanal a cada rincón, manteniendo siempre los más altos estándares de calidad y un servicio personalizado para cada cliente.</p></div><div class=\"grid sm:grid-cols-2 gap-4\"><div class=\"rounded-2xl border border-[#C67B3A]/15 bg-white/50 p-6\" style=\"opacity:0;transform:translateY(20px)\"><div class=\"flex h-10 w-10 items-center justify-center rounded-xl bg-[#2D1F14] text-[#F5EFE0]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" fill=\"currentColor\" viewBox=\"0 0 256 256\"><path d=\"M232,208h-8V136c0-.05,0-.09,0-.14s0-.29,0-.43,0-.28,0-.41a.76.76,0,0,0,0-.15l-15-105.13A16.08,16.08,0,0,0,193.06,16H174.94A16.08,16.08,0,0,0,159.1,29.74l-11.56,80.91L108.8,81.6A8,8,0,0,0,96,88v32L44.8,81.6A8,8,0,0,0,32,88V208H24a8,8,0,0,0,0,16H232a8,8,0,0,0,0-16ZM108,184H80a8,8,0,0,1,0-16h28a8,8,0,0,1,0,16Zm68,0H148a8,8,0,0,1,0-16h28a8,8,0,0,1,0,16Zm-5.33-56-8.53-6.4L174.94,32h18.12l13.72,96Z\"></path></svg></div><h3 class=\"mt-4 font-display text-xl text-[#2D1F14]\">Fábrica propia</h3><p class=\"mt-2 text-sm leading-6 text-[#2D1F14]/65\">Elaboramos nuestros helados en nuestra propia planta con control total de calidad.</p></div><div class=\"rounded-2xl border border-[#C67B3A]/15 bg-white/50 p-6\" style=\"opacity:0;transform:translateY(20px)\"><div class=\"flex h-10 w-10 items-center justify-center rounded-xl bg-[#2D1F14] text-[#F5EFE0]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" fill=\"currentColor\" viewBox=\"0 0 256 256\"><path d=\"M223.45,40.07a8,8,0,0,0-7.52-7.52C139.8,28.08,78.82,51,52.82,94a87.09,87.09,0,0,0-12.76,49A101.72,101.72,0,0,0,46.7,175.2a4,4,0,0,0,6.61,1.43l85-86.3a8,8,0,0,1,11.32,11.32L56.74,195.94,42.55,210.13a8.2,8.2,0,0,0-.6,11.1,8,8,0,0,0,11.71.43l16.79-16.79c14.14,6.84,28.41,10.57,42.56,11.07q1.67.06,3.33.06A86.93,86.93,0,0,0,162,203.18C205,177.18,227.93,116.21,223.45,40.07Z\"></path></svg></div><h3 class=\"mt-4 font-display text-xl text-[#2D1F14]\">Ingredientes naturales</h3><p class=\"mt-2 text-sm leading-6 text-[#2D1F14]/65\">Usamos ingredientes de primera calidad, sin conservantes artificiales.</p></div><div class=\"rounded-2xl border border-[#C67B3A]/15 bg-white/50 p-6\" style=\"opacity:0;transform:translateY(20px)\"><div class=\"flex h-10 w-10 items-center justify-center rounded-xl bg-[#2D1F14] text-[#F5EFE0]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" fill=\"currentColor\" viewBox=\"0 0 256 256\"><path d=\"M240,102c0,70-103.79,126.66-108.21,129a8,8,0,0,1-7.58,0C119.79,228.66,16,172,16,102A62.07,62.07,0,0,1,78,40c20.65,0,38.73,8.88,50,23.89C139.27,48.88,157.35,40,178,40A62.07,62.07,0,0,1,240,102Z\"></path></svg></div><h3 class=\"mt-4 font-display text-xl text-[#2D1F14]\">Hecho con dedicación</h3><p class=\"mt-2 text-sm leading-6 text-[#2D1F14]/65\">Cada sabor es desarrollado artesanalmente con atención al detalle.</p></div><div class=\"rounded-2xl border border-[#C67B3A]/15 bg-white/50 p-6\" style=\"opacity:0;transform:translateY(20px)\"><div class=\"flex h-10 w-10 items-center justify-center rounded-xl bg-[#2D1F14] text-[#F5EFE0]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" fill=\"currentColor\" viewBox=\"0 0 256 256\"><path d=\"M234.29,114.85l-45,38.83L203,211.75a16.4,16.4,0,0,1-24.5,17.82L128,198.49,77.47,229.57A16.4,16.4,0,0,1,53,211.75l13.76-58.07-45-38.83A16.46,16.46,0,0,1,31.08,86l59-4.76,22.76-55.08a16.36,16.36,0,0,1,30.27,0l22.75,55.08,59,4.76a16.46,16.46,0,0,1,9.37,28.86Z\"></path></svg></div><h3 class=\"mt-4 font-display text-xl text-[#2D1F14]\">Experiencia comprobada</h3><p class=\"mt-2 text-sm leading-6 text-[#2D1F14]/65\">Años abasteciendo negocios gastronómicos con productos de excelencia.</p></div></div></div></div></section><section id=\"proceso\" class=\"px-4 py-20 md:py-24 bg-[#E8D5B5]/30\"><div class=\"max-w-6xl mx-auto\"><div class=\"text-center max-w-2xl mx-auto\" style=\"opacity:0;transform:translateY(20px)\"><span class=\"section-label\">Nuestro proceso</span><h2 class=\"mt-4 font-display text-3xl md:text-4xl leading-tight text-[#2D1F14]\">De nuestra fábrica a tu negocio.</h2><p class=\"mt-4 text-base leading-7 text-[#2D1F14]/70\">Un proceso cuidadosamente diseñado para que recibas el mejor producto, en las mejores condiciones, siempre.</p></div><div class=\"mt-14 relative\"><div class=\"hidden lg:block absolute top-16 left-[16.67%] right-[16.67%] h-0.5 bg-[#C67B3A]/25\"></div><div class=\"grid md:grid-cols-3 gap-8 lg:gap-6\"><div class=\"relative\" style=\"opacity:0;transform:translateY(20px)\"><div class=\"flex flex-col items-center\"><div class=\"relative z-10 flex h-16 w-16 items-center justify-center rounded-full bg-[#2D1F14] text-[#F5EFE0] shadow-lg\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"28\" height=\"28\" fill=\"currentColor\" viewBox=\"0 0 256 256\"><path d=\"M232,208h-8V136c0-.05,0-.09,0-.14s0-.29,0-.43,0-.28,0-.41a.76.76,0,0,0,0-.15l-15-105.13A16.08,16.08,0,0,0,193.06,16H174.94A16.08,16.08,0,0,0,159.1,29.74l-11.56,80.91L108.8,81.6A8,8,0,0,0,96,88v32L44.8,81.6A8,8,0,0,0,32,88V208H24a8,8,0,0,0,0,16H232a8,8,0,0,0,0-16ZM108,184H80a8,8,0,0,1,0-16h28a8,8,0,0,1,0,16Zm68,0H148a8,8,0,0,1,0-16h28a8,8,0,0,1,0,16Zm-5.33-56-8.53-6.4L174.94,32h18.12l13.72,96Z\"></path></svg></div><span class=\"mt-3 text-xs font-bold tracking-[0.2em] text-[#9C5A22]\">PASO <!-- -->01</span></div><div class=\"mt-5 text-center rounded-2xl border border-[#C67B3A]/15 bg-white/60 p-6\"><h3 class=\"font-display text-xl text-[#2D1F14]\">Elaboración en nuestra fábrica</h3><p class=\"mt-3 text-sm leading-6 text-[#2D1F14]/65\">Producimos cada helado artesanalmente en nuestra planta propia, siguiendo recetas tradicionales con ingredientes seleccionados.</p></div></div><div class=\"relative\" style=\"opacity:0;transform:translateY(20px)\"><div class=\"flex flex-col items-center\"><div class=\"relative z-10 flex h-16 w-16 items-center justify-center rounded-full bg-[#2D1F14] text-[#F5EFE0] shadow-lg\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"28\" height=\"28\" fill=\"currentColor\" viewBox=\"0 0 256 256\"><path d=\"M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm42.37,119.22,18.94-6.76a8,8,0,1,1,5.38,15.08l-15.48,5.52,4.52,16.87a8,8,0,0,1-5.66,9.8A8.23,8.23,0,0,1,176,184a8,8,0,0,1-7.73-5.93l-5.57-20.8L136,141.86v30.83l13.66,13.65a8,8,0,0,1-11.32,11.32L128,187.31l-10.34,10.35a8,8,0,0,1-11.32-11.32L120,172.69V141.86L93.3,157.27l-5.57,20.8A8,8,0,0,1,80,184a8.23,8.23,0,0,1-2.07-.27,8,8,0,0,1-5.66-9.8l4.52-16.87-15.48-5.52a8,8,0,0,1,5.38-15.08l18.94,6.76L112,128,85.63,112.78l-18.94,6.76A8.18,8.18,0,0,1,64,120a8,8,0,0,1-2.69-15.54l15.48-5.52L72.27,82.07a8,8,0,0,1,15.46-4.14l5.57,20.8L120,114.14V83.31L106.34,69.66a8,8,0,0,1,11.32-11.32L128,68.69l10.34-10.35a8,8,0,0,1,11.32,11.32L136,83.31v30.83l26.7-15.41,5.57-20.8a8,8,0,0,1,15.46,4.14l-4.52,16.87,15.48,5.52A8,8,0,0,1,192,120a8.18,8.18,0,0,1-2.69-.46l-18.94-6.76L144,128Z\"></path></svg></div><span class=\"mt-3 text-xs font-bold tracking-[0.2em] text-[#9C5A22]\">PASO <!-- -->02</span></div><div class=\"mt-5 text-center rounded-2xl border border-[#C67B3A]/15 bg-white/60 p-6\"><h3 class=\"font-display text-xl text-[#2D1F14]\">Almacenaje en cámaras de frío</h3><p class=\"mt-3 text-sm leading-6 text-[#2D1F14]/65\">Conservamos el producto en cámaras frigoríficas de última generación que garantizan la cadena de frío perfecta.</p></div></div><div class=\"relative\" style=\"opacity:0;transform:translateY(20px)\"><div class=\"flex flex-col items-center\"><div class=\"relative z-10 flex h-16 w-16 items-center justify-center rounded-full bg-[#2D1F14] text-[#F5EFE0] shadow-lg\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"28\" height=\"28\" fill=\"currentColor\" viewBox=\"0 0 256 256\"><path d=\"M255.43,117l-14-35A15.93,15.93,0,0,0,226.58,72H192V64a8,8,0,0,0-8-8H32A16,16,0,0,0,16,72V184a16,16,0,0,0,16,16H49a32,32,0,0,0,62,0h50a32,32,0,0,0,62,0h17a16,16,0,0,0,16-16V120A8.13,8.13,0,0,0,255.43,117ZM80,208a16,16,0,1,1,16-16A16,16,0,0,1,80,208ZM32,136V72H176v64Zm160,72a16,16,0,1,1,16-16A16,16,0,0,1,192,208Zm0-96V88h34.58l9.6,24Z\"></path></svg></div><span class=\"mt-3 text-xs font-bold tracking-[0.2em] text-[#9C5A22]\">PASO <!-- -->03</span></div><div class=\"mt-5 text-center rounded-2xl border border-[#C67B3A]/15 bg-white/60 p-6\"><h3 class=\"font-display text-xl text-[#2D1F14]\">Despacho con vehículos equipados</h3><p class=\"mt-3 text-sm leading-6 text-[#2D1F14]/65\">Transportamos con vehículos altamente equipados para mantener el producto en óptimas condiciones hasta tu negocio.</p></div></div></div></div><div class=\"mt-12 flex flex-col sm:flex-row items-center justify-center gap-3 text-sm text-[#2D1F14]/60\" style=\"opacity:0;transform:translateY(20px)\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" fill=\"currentColor\" viewBox=\"0 0 256 256\" class=\"text-[#C67B3A]\"><path d=\"M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm45.66,85.66-56,56a8,8,0,0,1-11.32,0l-24-24a8,8,0,0,1,11.32-11.32L112,148.69l50.34-50.35a8,8,0,0,1,11.32,11.32Z\"></path></svg><span>Garantizamos la cadena de frío en todo momento</span></div></div></section><section id=\"plus\" class=\"px-4 py-20 md:py-24 bg-[#F5EFE0]\"><div class=\"max-w-6xl mx-auto\"><div class=\"text-center max-w-2xl mx-auto\" style=\"opacity:0;transform:translateY(20px)\"><span class=\"section-label\">Ventajas Kayen</span><h2 class=\"mt-4 font-display text-3xl md:text-4xl leading-tight text-[#2D1F14]\">Lo que nos diferencia.</h2><p class=\"mt-4 text-base leading-7 text-[#2D1F14]/70\">Más que un proveedor, somos un aliado para que tu negocio crezca con un producto que destaca.</p></div><div class=\"mt-14 grid sm:grid-cols-2 lg:grid-cols-3 gap-5\"><div class=\"group rounded-2xl border border-[#C67B3A]/12 bg-white/50 p-6 hover:bg-white/80 transition-smooth\" style=\"opacity:0;transform:translateY(20px)\"><div class=\"flex items-center gap-3\"><div class=\"flex h-10 w-10 items-center justify-center rounded-xl bg-[#C67B3A]/10 text-[#9C5A22]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" fill=\"currentColor\" viewBox=\"0 0 256 256\"><path d=\"M212,56a28,28,0,1,0,28,28A28,28,0,0,0,212,56Zm0,40a12,12,0,1,1,12-12A12,12,0,0,1,212,96Zm-60,50.08V40a32,32,0,0,0-64,0V146.08a56,56,0,1,0,64,0ZM136,104H104V40a16,16,0,0,1,32,0Z\"></path></svg></div><h3 class=\"font-display text-lg text-[#2D1F14]\">Cadena de frío garantizada</h3></div><p class=\"mt-3 text-sm leading-6 text-[#2D1F14]/65\">Cámaras de frío propias y vehículos equipados mantienen el producto en temperatura óptima.</p></div><div class=\"group rounded-2xl border border-[#C67B3A]/12 bg-white/50 p-6 hover:bg-white/80 transition-smooth\" style=\"opacity:0;transform:translateY(20px)\"><div class=\"flex items-center gap-3\"><div class=\"flex h-10 w-10 items-center justify-center rounded-xl bg-[#C67B3A]/10 text-[#9C5A22]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" fill=\"currentColor\" viewBox=\"0 0 256 256\"><path d=\"M255.43,117l-14-35A15.93,15.93,0,0,0,226.58,72H192V64a8,8,0,0,0-8-8H32A16,16,0,0,0,16,72V184a16,16,0,0,0,16,16H49a32,32,0,0,0,62,0h50a32,32,0,0,0,62,0h17a16,16,0,0,0,16-16V120A8.13,8.13,0,0,0,255.43,117ZM80,208a16,16,0,1,1,16-16A16,16,0,0,1,80,208ZM32,136V72H176v64Zm160,72a16,16,0,1,1,16-16A16,16,0,0,1,192,208Zm0-96V88h34.58l9.6,24Z\"></path></svg></div><h3 class=\"font-display text-lg text-[#2D1F14]\">Distribución propia</h3></div><p class=\"mt-3 text-sm leading-6 text-[#2D1F14]/65\">No dependemos de terceros. Nuestros vehículos llegan a tu negocio con puntualidad.</p></div><div class=\"group rounded-2xl border border-[#C67B3A]/12 bg-white/50 p-6 hover:bg-white/80 transition-smooth\" style=\"opacity:0;transform:translateY(20px)\"><div class=\"flex items-center gap-3\"><div class=\"flex h-10 w-10 items-center justify-center rounded-xl bg-[#C67B3A]/10 text-[#9C5A22]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" fill=\"currentColor\" viewBox=\"0 0 256 256\"><path d=\"M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm56,112H128a8,8,0,0,1-8-8V72a8,8,0,0,1,16,0v48h48a8,8,0,0,1,0,16Z\"></path></svg></div><h3 class=\"font-display text-lg text-[#2D1F14]\">Respuesta rápida</h3></div><p class=\"mt-3 text-sm leading-6 text-[#2D1F14]/65\">Atención comercial ágil. Resolvemos tus pedidos y consultas en tiempo récord.</p></div><div class=\"group rounded-2xl border border-[#C67B3A]/12 bg-white/50 p-6 hover:bg-white/80 transition-smooth\" style=\"opacity:0;transform:translateY(20px)\"><div class=\"flex items-center gap-3\"><div class=\"flex h-10 w-10 items-center justify-center rounded-xl bg-[#C67B3A]/10 text-[#9C5A22]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" fill=\"currentColor\" viewBox=\"0 0 256 256\"><path d=\"M208,40H48A16,16,0,0,0,32,56v56c0,52.72,25.52,84.67,46.93,102.19,23.06,18.86,46,25.26,47,25.53a8,8,0,0,0,4.2,0c1-.27,23.91-6.67,47-25.53C198.48,196.67,224,164.72,224,112V56A16,16,0,0,0,208,40Zm-34.32,69.66-56,56a8,8,0,0,1-11.32,0l-24-24a8,8,0,0,1,11.32-11.32L112,148.69l50.34-50.35a8,8,0,0,1,11.32,11.32Z\"></path></svg></div><h3 class=\"font-display text-lg text-[#2D1F14]\">Calidad certificada</h3></div><p class=\"mt-3 text-sm leading-6 text-[#2D1F14]/65\">Cumplimos con todos los estándares de inocuidad alimentaria y buenas prácticas.</p></div><div class=\"group rounded-2xl border border-[#C67B3A]/12 bg-white/50 p-6 hover:bg-white/80 transition-smooth\" style=\"opacity:0;transform:translateY(20px)\"><div class=\"flex items-center gap-3\"><div class=\"flex h-10 w-10 items-center justify-center rounded-xl bg-[#C67B3A]/10 text-[#9C5A22]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" fill=\"currentColor\" viewBox=\"0 0 256 256\"><path d=\"M223.68,66.15,135.68,18a15.88,15.88,0,0,0-15.36,0l-88,48.17a16,16,0,0,0-8.32,14v95.64a16,16,0,0,0,8.32,14l88,48.17a15.88,15.88,0,0,0,15.36,0l88-48.17a16,16,0,0,0,8.32-14V80.18A16,16,0,0,0,223.68,66.15ZM128,32l80.35,44L178.57,92.29l-80.35-44Zm0,88L47.65,76,81.56,57.43l80.35,44Zm88,55.85h0l-80,43.79V133.83l32-17.51V152a8,8,0,0,0,16,0V107.56l32-17.51v85.76Z\"></path></svg></div><h3 class=\"font-display text-lg text-[#2D1F14]\">Formatos flexibles</h3></div><p class=\"mt-3 text-sm leading-6 text-[#2D1F14]/65\">Disponibles en distintos formatos y volúmenes según las necesidades de tu negocio.</p></div><div class=\"group rounded-2xl border border-[#C67B3A]/12 bg-white/50 p-6 hover:bg-white/80 transition-smooth\" style=\"opacity:0;transform:translateY(20px)\"><div class=\"flex items-center gap-3\"><div class=\"flex h-10 w-10 items-center justify-center rounded-xl bg-[#C67B3A]/10 text-[#9C5A22]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" fill=\"currentColor\" viewBox=\"0 0 256 256\"><path d=\"M232,128v56a24,24,0,0,1-24,24H192a24,24,0,0,1-24-24V144a24,24,0,0,1,24-24h23.65a87.71,87.71,0,0,0-87-80H128a88,88,0,0,0-87.64,80H64a24,24,0,0,1,24,24v40a24,24,0,0,1-24,24H48a24,24,0,0,1-24-24V128A104.11,104.11,0,0,1,201.89,54.66,103.41,103.41,0,0,1,232,128Z\"></path></svg></div><h3 class=\"font-display text-lg text-[#2D1F14]\">Acompañamiento comercial</h3></div><p class=\"mt-3 text-sm leading-6 text-[#2D1F14]/65\">Te asesoramos en surtido, presentación y estrategia para vender más helado.</p></div></div></div></section><section id=\"contacto\" class=\"px-4 py-20 md:py-24 bg-[#2D1F14]\"><div class=\"max-w-6xl mx-auto\"><div class=\"grid lg:grid-cols-2 gap-12 lg:gap-16\"><div style=\"opacity:0;transform:translateY(20px)\"><span class=\"section-label text-[#C67B3A]\">Contacto</span><h2 class=\"mt-4 font-display text-3xl md:text-4xl leading-tight text-[#F5EFE0]\">Hablemos de tu negocio.</h2><p class=\"mt-5 text-base leading-7 text-[#F5EFE0]/65\">¿Querés ofrecer helados artesanales de calidad en tu negocio? Escribinos y te ayudamos a elegir el surtido ideal.</p><div class=\"mt-8 space-y-5\"><a href=\"https://wa.me/1234567890\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"flex items-center gap-4 group\"><div class=\"flex h-12 w-12 items-center justify-center rounded-full bg-[#F5EFE0]/10 text-[#F5EFE0] group-hover:bg-[#C67B3A] transition-smooth\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"22\" height=\"22\" fill=\"currentColor\" viewBox=\"0 0 256 256\"><path d=\"M152.58,145.23l23,11.48A24,24,0,0,1,152,176a72.08,72.08,0,0,1-72-72A24,24,0,0,1,99.29,80.46l11.48,23L101,118a8,8,0,0,0-.73,7.51,56.47,56.47,0,0,0,30.15,30.15A8,8,0,0,0,138,155ZM232,128A104,104,0,0,1,79.12,219.82L45.07,231.17a16,16,0,0,1-20.24-20.24l11.35-34.05A104,104,0,1,1,232,128Zm-40,24a8,8,0,0,0-4.42-7.16l-32-16a8,8,0,0,0-8,.5l-14.69,9.8a40.55,40.55,0,0,1-16-16l9.8-14.69a8,8,0,0,0,.5-8l-16-32A8,8,0,0,0,104,64a40,40,0,0,0-40,40,88.1,88.1,0,0,0,88,88A40,40,0,0,0,192,152Z\"></path></svg></div><div><p class=\"text-sm text-[#F5EFE0]/50\">WhatsApp</p><p class=\"text-[#F5EFE0]\">+54 9 11 1234 5678</p></div></a><a href=\"mailto:hola@kayen.com\" class=\"flex items-center gap-4 group\"><div class=\"flex h-12 w-12 items-center justify-center rounded-full bg-[#F5EFE0]/10 text-[#F5EFE0] group-hover:bg-[#C67B3A] transition-smooth\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"22\" height=\"22\" fill=\"currentColor\" viewBox=\"0 0 256 256\"><path d=\"M224,48H32a8,8,0,0,0-8,8V192a16,16,0,0,0,16,16H216a16,16,0,0,0,16-16V56A8,8,0,0,0,224,48ZM98.71,128,40,181.81V74.19Zm11.84,10.85,12,11.05a8,8,0,0,0,10.82,0l12-11.05,58,53.15H52.57ZM157.29,128,216,74.18V181.82Z\"></path></svg></div><div><p class=\"text-sm text-[#F5EFE0]/50\">Email</p><p class=\"text-[#F5EFE0]\">hola@kayen.com</p></div></a><div class=\"flex items-center gap-4\"><div class=\"flex h-12 w-12 items-center justify-center rounded-full bg-[#F5EFE0]/10 text-[#F5EFE0]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"22\" height=\"22\" fill=\"currentColor\" viewBox=\"0 0 256 256\"><path d=\"M128,16a88.1,88.1,0,0,0-88,88c0,75.3,80,132.17,83.41,134.55a8,8,0,0,0,9.18,0C136,236.17,216,179.3,216,104A88.1,88.1,0,0,0,128,16Zm0,56a32,32,0,1,1-32,32A32,32,0,0,1,128,72Z\"></path></svg></div><div><p class=\"text-sm text-[#F5EFE0]/50\">Ubicación</p><p class=\"text-[#F5EFE0]\">